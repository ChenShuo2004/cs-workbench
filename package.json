{
  "name": "cs-workbench",
  "productName": "CS 工作台",
  "version": "0.1.0",
  "description": "陈硕的本地自媒体内容工作台",
  "main": "electron/main.cjs",
  "author": "Chen Shuo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "npm run build && electron-forge make --platform=darwin --arch=arm64",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.5.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
