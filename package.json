{
  "name": "cs-workbench",
  "productName": "CS 工作台 Pro",
  "version": "0.7.0",
  "description": "本地个人工作台：任务、记忆、文件、Agent 与视频创作",
  "main": "electron/main.cjs",
  "author": "Chen Shuo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "npm run build && electron-forge make --platform=darwin --arch=arm64",
    "test": "node --test tests/*.test.cjs",
    "verify:studio": "npm run build && node scripts/verify-studio.cjs",
    "verify:personal": "npm run build && node scripts/verify-personal.cjs",
    "verify:talk": "npm run build && node scripts/verify-talk.cjs",
    "verify:creator": "npm run build && node scripts/verify-creator.cjs",
    "verify:appearance": "npm run build && node scripts/verify-appearance.cjs",
    "verify:experience": "npm run build && node scripts/verify-experience.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.5.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
